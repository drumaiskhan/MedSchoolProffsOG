# ---------------------------------------------------------------------------
# Copy this file to .env at the repo root for local dev. For deployed
# platforms (Railway, Render, Vercel, Netlify, Fly...), set these as real
# environment variables in that platform's dashboard instead — see
# DEPLOYMENT.md for platform-specific notes.
# ---------------------------------------------------------------------------

# Database (required)
DATABASE_URL=postgres://user:password@host:5432/medschoolproffs

# Auth (required)
JWT_SECRET=replace-with-a-long-random-string

# First-boot admin seed — only used if no admin account exists yet. Leave
# unset to use this repo's hardcoded defaults (umais0khan@gmail.com /
# Umaiskhan000) — fine for local dev, but set these for any real deploy so
# the seeded login isn't a publicly-known password. Change the account's
# credentials from Admin -> Platform settings -> Your account after first
# login either way; these env vars only matter once, on first boot.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# The frontend's URL(s), comma-separated if more than one (e.g. a Vercel
# preview + production domain, or — for local dev — both the student app on
# 5173 and the admin app on 5174, since `pnpm run dev` runs both at once).
# Used for CORS.
APP_URL=http://localhost:5173,http://localhost:5174

# Ports (all optional — sensible local defaults are used if unset)
PORT=3001
API_PORT=3001
# Only needed if running the frontend dev server separately from api-server
# on a non-default port; points Vite's /api proxy at the backend.
API_PROXY_TARGET=http://localhost:3001

# Split-deployment support (frontend and backend on different domains, e.g.
# frontend on Vercel/Netlify + backend on Railway/Render). Leave both unset
# for same-origin/monolithic deployments.
# COOKIE_CROSS_SITE=true          # set on the BACKEND when frontend/backend are cross-origin
# VITE_API_BASE_URL=https://your-api.up.railway.app   # set on the FRONTEND build, no trailing /api

# Email (SMTP) — leave unset in dev to log emails to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@medschoolproffs.com

# File storage — Cloudinary is the only upload backend (no local-disk
# fallback exists; it was removed because Vercel, Netlify, Railway, and
# Render all wipe local disk on redeploy/restart, which previously caused
# uploads to silently vanish). Supabase (DATABASE_URL above) is used for
# this app's database only, not for storage. Can also be set from
# Admin -> Platform settings -> Storage instead of here, without server
# access — these env vars are the fallback for that.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI-generated explanations (optional) — set one of these to enable
# "Generate with AI" in Admin -> MCQ bank and the student "Ask AI" button.
# Anthropic is preferred if both are set. Neither set = those buttons return
# a clear "not configured" message instead of failing silently.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

NODE_ENV=development
