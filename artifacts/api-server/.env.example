DATABASE_URL=

JWT_SECRET=

# Seed values for the one bootstrap admin account created on first run.
# Change these before deploying, and rotate the password afterwards from
# Admin > Settings — do not leave the seeded credential in place.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS. With the
# frontend split into two apps, list BOTH origins here, e.g.:
#   APP_URL=https://app.medschoolproffs.com,https://admin.medschoolproffs.com
APP_URL=

# Required whenever a frontend is deployed on a different origin than this
# API (which is always true for the split setup above) — without it, the
# session cookie is silently dropped by the browser and users see
# "Please sign in to continue" right after a successful login.
COOKIE_CROSS_SITE=true

# development | production — production also implies secure cookies.
NODE_ENV=development

LOG_LEVEL=info

# File storage — Cloudinary only; Supabase (DATABASE_URL) is used for the
# database, not storage. Required; there is no local-disk fallback. See root
# .env.example for the full explanation.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
