DATABASE_URL=

JWT_SECRET=

# Seed values for the one bootstrap admin account created on first run.
# Change these before deploying, and rotate the password afterwards from
# Admin > Settings — do not leave the seeded credential in place.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS. With the
# frontend split into two apps, list BOTH origins here, e.g.:
#   APP_URL=https://app.medschoolproffs.com,https://admin.medschoolproffs.com
APP_URL=

# Required whenever a frontend is deployed on a different origin than this
# API (which is always true for the split setup above) — without it, the
# session cookie is silently dropped by the browser and users see
# "Please sign in to continue" right after a successful login.
COOKIE_CROSS_SITE=true

# development | production — production also implies secure cookies.
NODE_ENV=development

LOG_LEVEL=info

# File storage — Cloudinary only; Supabase (DATABASE_URL) is used for the
# database, not storage. Required; there is no local-disk fallback. See root
# .env.example for the full explanation.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Transactional email -----------------------------------------------
# Used for: email verification, "welcome" (sent right after verification),
# forgot/reset password, membership-activated, trial-started, and
# payment submitted/rejected emails.
#
# These can now ALSO be configured from Admin -> Settings -> Email, without
# touching env vars or redeploying — the DB-saved settings win if present,
# these env vars are the fallback (and the only option for a deployment
# that never opens the admin settings UI). Set only one provider — the
# others' vars are ignored if unset:
#
# 1) Brevo (recommended) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MedschoolProffs
#
# 2) Any other transactional email API. Point this at an endpoint that
# accepts POST { to, subject, html, from, fromName } as JSON.
CUSTOM_EMAIL_API_URL=
CUSTOM_EMAIL_API_KEY=
# Header name/prefix the custom API expects the key in. Defaults below work
# for "Authorization: Bearer <key>"; set CUSTOM_EMAIL_API_KEY_HEADER=api-key
# and CUSTOM_EMAIL_API_KEY_PREFIX= (empty) for providers like Brevo/SendGrid
# style raw-key headers instead.
CUSTOM_EMAIL_API_KEY_HEADER=Authorization
CUSTOM_EMAIL_API_KEY_PREFIX=Bearer 
#
# 3) Plain SMTP — used if neither of the above is set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
#
# Sender address used by any provider above if not set via the admin UI.
MAIL_FROM=
