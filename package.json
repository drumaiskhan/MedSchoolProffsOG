{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "concurrently -n api,student,admin -c blue,green,yellow \"pnpm run dev:api\" \"pnpm run dev:student\" \"pnpm run dev:admin\"",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:student": "pnpm --filter @workspace/frontend-student run dev",
    "dev:admin": "pnpm --filter @workspace/frontend-admin run dev",
    "build:api": "tsc --build && pnpm --filter @workspace/api-server run build",
    "build:student": "tsc --build && pnpm --filter @workspace/frontend-student run build",
    "build:admin": "tsc --build && pnpm --filter @workspace/frontend-admin run build",
    "start": "pnpm --filter @workspace/api-server run start",
    "db:push": "pnpm --filter @workspace/db run push"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
